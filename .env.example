# Copy this file to .env and fill in your own values.
# NEVER commit the .env file. It is listed in .gitignore.

# Your Jira Cloud site, e.g. https://yourcompany.atlassian.net (no trailing slash)
JIRA_BASE_URL=https://your-site.atlassian.net

# The email address you log in to Jira with
JIRA_EMAIL=you@example.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=paste-your-jira-api-token-here

# Create at: https://console.anthropic.com (Settings > API Keys)
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here